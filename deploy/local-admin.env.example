# Copy to deploy/local-admin.env and set permissions with chmod 600.
# Used by compose.local.yaml for seeding the initial admin account.
# Provide a literal bcrypt hash (cost 10-14, without quotes). Store no plaintext password.
# To generate a hash locally:
#   python3 -c 'import bcrypt; print(bcrypt.hashpw(b"YourPassword1", bcrypt.gensalt(10)).decode())'
DEV_ADMIN_PASSWORD_HASH=
