# Copy to deploy/local-admin.env and set permissions with chmod 600.
# Used by compose.local.yaml for seeding the initial admin and demo guest accounts.
# Provide literal bcrypt hashes (cost 10-14). Store no plaintext password.
# Quotes are optional; single quotes keep Compose from reading the '$' signs.
# To generate a hash locally:
#   python3 -c 'import bcrypt; print(bcrypt.hashpw(b"YourPassword1", bcrypt.gensalt(10)).decode())'
DEV_ADMIN_PASSWORD_HASH=
DEV_GUEST_PASSWORD_HASH=
