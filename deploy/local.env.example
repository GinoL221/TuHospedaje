# Copy to deploy/local.env; never commit real values. Use chmod 600.
LOCAL_DB_PASSWORD=
LOCAL_DB_ROOT_PASSWORD=
# Base64-encoded random 48-byte keys; keep stable between starts.
LOCAL_JWT_SECRET=
LOCAL_SESSION_REFRESH_KEY=
CANONICAL_ASSETS_HOST_DIR=/home/ginopc/TuHospedajeAssets/canonical-lodging-images

# Separate file deploy/local-admin.env (chmod 600), read ONLY by seed-entrypoint:
# DEV_ADMIN_PASSWORD_HASH=<literal bcrypt hash, cost 10-14, no quotes>
# Do not include the bcrypt hash in the Compose --env-file: dollar signs
# must reach the seed entrypoint unchanged. Store no plaintext admin password.
