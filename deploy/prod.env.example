PROD_DB_NAME=
PROD_DB_ROOT_PASSWORD=
DB_RUNTIME_USERNAME=
DB_RUNTIME_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
JWT_SECRET=
SESSION_ACTIVE_KEY_ID=
SESSION_REFRESH_KEY=
CORS_ALLOWED_ORIGINS=
TUHOSPEDAJE_WELCOME_PUBLIC_BASE_URL=
BACKEND_IMAGE=
FRONTEND_IMAGE=

# PROD_HTTP_BIND_ADDRESS=127.0.0.1
# PROD_HTTP_PORT=8080
# BUSINESS_TIME_ZONE=America/Argentina/Buenos_Aires
# VITE_WHATSAPP_NUMBER=

# MAIL_SMTP_ENABLED=false
# MAILTRAP_HOST=
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=

# Compose sets /uploads inside the container (on a persistent volume); override
# only if you move the storage location.
# TUHOSPEDAJE_UPLOADS_DIR=/uploads

# Image URL prefix returned by the upload API. Same-origin in prod (nginx forwards
# /uploads/ to the backend); override only for a different origin.
# TUHOSPEDAJE_UPLOADS_PUBLIC_PREFIX=/uploads

# Reverse proxy / real client IP resolution: regex matching trusted internal proxy IPs.
# Defaults to standard RFC 1918 private subnets + loopback. Override if behind a custom CIDR.
# TOMCAT_INTERNAL_PROXIES=
