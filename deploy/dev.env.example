# DEV_BACKEND_PORT=8080
# DEV_FRONTEND_PORT=5173

# MAIL_SMTP_ENABLED=false
# MAILTRAP_HOST=
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=

# Compose sets /uploads inside the container (on a persistent volume); override
# only if you move the storage location.
# TUHOSPEDAJE_UPLOADS_DIR=/uploads

# Image URL prefix returned by the upload API. Dev compose serves the frontend with
# Vite (no API proxy), so its default is absolute against the published backend port
# (http://localhost:${DEV_BACKEND_PORT:-8080}/uploads); the nginx /uploads/ proxy
# exists only in the prod image, whose default is same-origin /uploads. Override
# only for a different origin.
# TUHOSPEDAJE_UPLOADS_PUBLIC_PREFIX=http://localhost:8080/uploads

# VITE_WHATSAPP_NUMBER=
