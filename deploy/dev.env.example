# Recommended: run ./scripts/dev-setup.sh to generate deploy/dev.env with random
# secrets and demo bcrypt hashes.
#
# Required formats if you fill this file manually:
# - DEV_DB_NAME: for compose.dev-seed.yaml, must contain a standalone "dev" or
#   "test" segment (for example: tuhospedaje_dev).
# - DEV_JWT_SECRET and DEV_SESSION_REFRESH_KEY: Base64-encoded >=32 bytes
#   (for example: openssl rand -base64 48).
DEV_DB_NAME=
DEV_DB_USERNAME=
DEV_DB_PASSWORD=
DEV_DB_ROOT_PASSWORD=
DEV_JWT_SECRET=
DEV_SESSION_REFRESH_KEY=

# Only needed when using compose.dev-seed.yaml: bcrypt hashes (cost 10-14).
# Surrounding single quotes are optional and keep Compose from interpolating '$'.
# DEV_ADMIN_PASSWORD_HASH=
# DEV_GUEST_PASSWORD_HASH=

# DEV_DB_PORT=3307
# DEV_BACKEND_PORT=8080
# DEV_FRONTEND_PORT=5173

# MAIL_SMTP_ENABLED=false
# MAILTRAP_HOST=
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=

# Compose sets /uploads inside the container (on a persistent volume); override
# only if you move the storage location.
# TUHOSPEDAJE_UPLOADS_DIR=/uploads

# Image URL prefix returned by the upload API. Dev compose serves the frontend with
# Vite (no API proxy), so its default is absolute against the published backend port
# (http://localhost:${DEV_BACKEND_PORT:-8080}/uploads); the nginx /uploads/ proxy
# exists only in the prod image, whose default is same-origin /uploads. Override
# only for a different origin.
# TUHOSPEDAJE_UPLOADS_PUBLIC_PREFIX=http://localhost:8080/uploads

# VITE_WHATSAPP_NUMBER=
