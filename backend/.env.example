   # Backend environment variables.
   # Copy this file to `backend/.env` and fill in the values:
   #   cp backend/.env.example backend/.env
   # Spring Boot loads it automatically via spring.config.import.
   # `backend/.env` is gitignored — never commit real secrets.

   # --- Required ---

   # Local MariaDB via docker compose on localhost:3307.
   DB_USERNAME=tuhospedaje
   DB_PASSWORD=
   DB_ROOT_PASSWORD=

   # Production-only Flyway account.
   DB_MIGRATION_USERNAME=tuhospedaje_migrator
   DB_MIGRATION_PASSWORD=

   # Base64-encoded secret of at least 256 bits.
   # Generate with: openssl rand -base64 48
   JWT_SECRET=

   # Refresh-session configuration.
   SESSION_ACTIVE_KEY_ID=dev-local
   SESSION_REFRESH_KEY=
   SESSION_REFRESH_RETRY_GRACE=PT5S

   # CORS allowed frontend origins.
   CORS_ALLOWED_ORIGINS=http://localhost:5173

   # Public URL used in welcome email links.
   TUHOSPEDAJE_WELCOME_PUBLIC_BASE_URL=https://app.example

   # --- Optional ---

   MAIL_SMTP_ENABLED=false
   # MAILTRAP_HOST=sandbox.smtp.mailtrap.io
   # MAILTRAP_PORT=2525
   # MAILTRAP_USERNAME=
   # MAILTRAP_PASSWORD=

   CLOUDINARY_CLOUD_NAME=
   CLOUDINARY_API_KEY=
   CLOUDINARY_API_SECRET=
