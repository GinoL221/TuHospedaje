# Backend environment variables.
# Copy this file to `backend/.env` and fill in the values:
#   cp backend/.env.example backend/.env
# Spring Boot loads it automatically via spring.config.import (see application.properties).
# `backend/.env` is gitignored — never commit real secrets.

# --- Required (no fallback — the app will NOT start without these) ---

# Database (local MariaDB on localhost:3306/tuhospedaje)
DB_USERNAME=tuhospedaje
DB_PASSWORD=tuhospedaje123

# Production only: dedicated Flyway account required on every startup and restart.
# Restrict it to necessary migration DDL/DML, rotate it periodically, and do not reuse the application account.
DB_MIGRATION_USERNAME=tuhospedaje_migrator
DB_MIGRATION_PASSWORD=replace-with-a-deployment-secret

# JWT signing secret. Must be Base64-encoded and decode to at least 256 bits (32 bytes) —
# a plain 32+ character passphrase will NOT work, it has to be valid Base64.
# Generate a strong one with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Refresh sessions are enabled by default (app.session.refresh.enabled=true).
# Both values below are required — the app will NOT start without them.
# Use an identifier for the active key and a generated secret.
SESSION_ACTIVE_KEY_ID=
SESSION_REFRESH_KEY=
SESSION_REFRESH_RETRY_GRACE=PT5S

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public application base URL used in stored WELCOME login links.
# Required outside the dev profile. Must be an absolute HTTPS public URL, not localhost.
TUHOSPEDAJE_WELCOME_PUBLIC_BASE_URL=https://app.example

# --- Optional (have safe defaults — override only if needed) ---

# Email: set to true to send via SMTP (Mailtrap/real). Default false = log to console.
MAIL_SMTP_ENABLED=false
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=

# Cloudinary (required only for image upload; tests run without it)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
