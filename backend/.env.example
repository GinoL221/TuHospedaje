# Backend environment variables.
# Copy this file to `backend/.env` and fill in the values:
#   cp backend/.env.example backend/.env
# Spring Boot loads it automatically via spring.config.import (see application.properties).
# `backend/.env` is gitignored — never commit real secrets.

# --- Required (no fallback — the app will NOT start without these) ---

# Database (local MariaDB on localhost:3306/tuhospedaje)
DB_USERNAME=tuhospedaje
DB_PASSWORD=tuhospedaje123

# JWT signing secret — must be at least 256 bits (32+ chars).
# Generate a strong one with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional (have safe defaults — override only if needed) ---

# Email: set to true to send via SMTP (Mailtrap/real). Default false = log to console.
MAIL_SMTP_ENABLED=false
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USERNAME=
# MAILTRAP_PASSWORD=

# Cloudinary (required only for image upload; tests run without it)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
