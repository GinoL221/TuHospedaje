{
  "name": "tuhospedaje-e2e",
  "version": "1.0.1",
  "description": "Playwright E2E tests for TuHospedaje — POM + fixtures pattern",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:local": "node scripts/run-e2e.cjs",
    "test:runner": "node --test scripts/run-e2e.test.cjs scripts/summarize-e2e-retries.test.cjs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chromium",
    "test:webkit": "E2E_ENABLE_WEBKIT=1 playwright test --project=mobile-webkit",
    "report": "playwright show-report",
    "clean": "rm -rf test-results playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7"
  }
}
